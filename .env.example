# =====================================================
# Digital Saathi — Environment Variables Template
# Copy to .env and fill in your actual values
# =====================================================
# IMPORTANT: Never commit the actual .env file to git!
# =====================================================

# ── Application ──────────────────────────────────────
APP_NAME="Digital Saathi"
ENVIRONMENT=development          # development | production
DEBUG=true                       # Set to false in production

# CRITICAL: Generate a strong random key for JWT signing
# Run: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_WITH_STRONG_SECRET_KEY_64_HEX_CHARS

# ── Database ─────────────────────────────────────────
# SQLite for local development (default — no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./digital_saathi.db

# PostgreSQL for production (uncomment and fill in)
# DATABASE_URL=postgresql+asyncpg://saathi:saathipassword@localhost:5432/digital_saathi

# PostgreSQL Docker Compose variables (used by db service)
POSTGRES_DB=digital_saathi
POSTGRES_USER=saathi
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_PORT=5432

# ── LLM / AI Provider ────────────────────────────────
# Options: demo | gemini | openai
# demo: No API key required — uses rule-based mock responses (good for testing)
# gemini: Google Gemini API (recommended for best Hindi support)
# openai: OpenAI GPT-4o
LLM_PROVIDER=demo

# Google Gemini (get key at: https://aistudio.google.com)
GEMINI_API_KEY=

# OpenAI (get key at: https://platform.openai.com)
OPENAI_API_KEY=

# Gemini model to use (when LLM_PROVIDER=gemini)
GEMINI_MODEL=gemini-1.5-flash

# ── File Upload Settings ──────────────────────────────
UPLOAD_DIR=./backend/uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt

# ── CORS / Origins ───────────────────────────────────
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# ── JWT Token Settings ───────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=480    # 8 hours
ALGORITHM=HS256

# ── Docker Compose Port Mapping ───────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=80

# ── Bhashini / Speech Integration (Optional) ─────────
# For production Hindi speech synthesis/recognition via Bhashini
# Register at: https://bhashini.gov.in/
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO
